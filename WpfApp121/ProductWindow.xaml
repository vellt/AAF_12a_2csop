<Window x:Class="WpfApp121.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp121"
        mc:Ignorable="d" Icon="./Images/favicon.ico" FontSize="18"
        Title="ProductWindow" SizeToContent="Height" Width="300">
    <StackPanel Margin="10">
        <Image Name="kep" Stretch="UniformToFill"/>
        <TextBlock Name="cim" Text="ASD" FontWeight="Bold" TextWrapping="Wrap" Margin="0 10 0 0"/>
        <TextBlock Name="kategoria" Text="ASD2" TextWrapping="Wrap"/>
        <TextBlock Name="ar" Text="ASD3" FontWeight="Black" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
