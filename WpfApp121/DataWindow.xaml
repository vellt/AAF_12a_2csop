<Window x:Class="WpfApp121.DataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp121"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Icon="Images/favicon.ico"
        Title="Adatbázis" Height="450" Width="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <!--bal oldal-->
        <GroupBox Header="Szűrő" Margin="15">
            <StackPanel>
                <Expander Header="Kategória" Margin="5">
                    <ComboBox Name="kategoria"/>
                </Expander>
                <Expander Header="Cím" Margin="5">
                    <TextBox Name="kereso"/>
                </Expander>
                <Button Name="gomb" Content="Alkalmaz" Margin="5"
                        Background="Teal" Padding="5"
                        Foreground="White"/>
            </StackPanel>
        </GroupBox>
        <!--másik bal (jobb)-->
        <GroupBox Header="Találat" Margin="15" Grid.Column="1">
            <ListBox Name="lista"/>
        </GroupBox>
    </Grid>
</Window>
