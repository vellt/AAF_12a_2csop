<Window x:Class="WpfApp125.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp125"
        mc:Ignorable="d" Icon="./Images/star_wars.ico"
        Title="Star Wars" Height="450" Width="450"
        Background="Black" WindowStartupLocation="CenterScreen"
        BorderThickness="5" BorderBrush="Yellow">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <Image Source="./Images/star_wars_logo.png"/>
        <Button Name="gomb" Content="Szereplők betöltése"
                Margin="0 20 0 20" Padding="5"
                Background="Yellow" FontSize="20"
                FontWeight="Bold"/>
    </StackPanel>
</Window>
