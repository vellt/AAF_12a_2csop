<Window x:Class="WpfApp125.DetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp125"
        mc:Ignorable="d" Icon="./Images/star_wars.ico" Background="Black"
        Title="Szereplő" SizeToContent="Height" Width="300">
    <Border CornerRadius="10" Background="Yellow" Margin="10">
        <StackPanel Margin="10">
            <Image Name="kep" Stretch="UniformToFill"/>
            <TextBlock Name="nev" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>
