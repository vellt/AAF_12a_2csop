<Window x:Class="WpfApp125.SzereplokWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp125"
        mc:Ignorable="d" Icon="./Images/star_wars.ico"
        WindowStartupLocation="CenterScreen" Background="Black"
        Title="SzereplokWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <!--bal oldal-->
        <StackPanel Margin="10 25 10 25">
            <Expander Header="Neme" Foreground="White" FontSize="20" Margin="5">
                <ComboBox Name="neme"/>
            </Expander>
            <Expander Header="Faj" Foreground="White" FontSize="20" Margin="5">
                <ComboBox Name="faj"/>
            </Expander>
            <Expander Header="Név" Foreground="White" FontSize="20" Margin="5">
                <TextBox Name="nev"/>
            </Expander>
            <Button Name="gomb" Background="Yellow" Padding="5" Margin="5 20 5 20"
                    FontWeight="Bold" Content="Alkalmaz" />
        </StackPanel>
        
        <!--jobb oldal-->
        <ListBox Name="lista" Grid.Column="1"
                 Margin="10 25 10 25" FontSize="20"
                 Foreground="White" BorderBrush="Transparent"
                 Background="Black"/>
    </Grid>
</Window>
