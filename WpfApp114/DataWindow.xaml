<Window x:Class="WpfApp114.DataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp114"
        mc:Ignorable="d" Icon="./Images/favicon.ico"
        Title="Adatbázis" Height="450" Width="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Szűrő" Margin="15">
            <StackPanel>
                <Expander Header="Műfaj">
                    <ComboBox Name="mufaj"/>
                </Expander>
                <Expander Header="korhatár">
                    <ComboBox Name="korhatar"/>
                </Expander>
                <Expander Header="cím">
                    <TextBox Name="cim"/>
                </Expander>
                <Button Name="gomb" Background="Black" Padding="5"
                        Margin="5" Content="Alkalmaz"
                        Foreground="White"/>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="találat" Grid.Column="1" Margin="15">
            <ListBox Name="lista"/>
        </GroupBox>
    </Grid>
</Window>
