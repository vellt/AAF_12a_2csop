<Window x:Class="WpfApp114.MovieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp114"
        mc:Ignorable="d" Icon="./images/favicon.ico"
        Title="MovieWindow" SizeToContent="Height" Width="300">
    <Border Background="LightGray" Margin="10" CornerRadius="10">
        <StackPanel Margin="10">
            <Image Stretch="UniformToFill"/>
            <TextBlock Text="Mickey 17" FontSize="20" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal">
                <Image Source="./Images/12.png"/>
                <TextBlock Text="Sci-fi" FontSize="20" Margin="5 0 0 0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
