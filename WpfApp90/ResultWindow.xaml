<Window x:Class="WpfApp90.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp90"
        mc:Ignorable="d" Background="Black" Foreground="White"
        Title="ResultWindow" Height="500" Width="500">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <GroupBox Header="Body Index" FontSize="20" Margin="0 0 0 20">
                <TextBlock Name="bodyIndex" Text="22" FontSize="40" Margin="20"/>
            </GroupBox>
            <GroupBox Header="Eredmény" FontSize="20">
                <TextBlock Name="szovegesEredmeny" Text="Normál" FontSize="40" Margin="20"/>
            </GroupBox>
        </StackPanel>
    </Grid>
</Window>
