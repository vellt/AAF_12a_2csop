<Window x:Class="WpfApp110.DataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp110"
        mc:Ignorable="d" Icon="./Images/icon.ico"
        WindowStartupLocation="CenterScreen"
        Title="DataWindow" Height="450" Width="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="15">
            <Expander Header="Szerző" FontSize="15" Margin="5">
                <ComboBox Name="szerzok" Margin="0 5 0 0"/>
            </Expander>
            <Button Name="gomb" Background="SteelBlue" Padding="5" Margin="5" Foreground="White"
                    Content="Alkalmaz"/>
        </StackPanel>
        

        <GroupBox Grid.Column="1" Header="találat" Margin="15">
            <DataGrid Name="tabla"/>
        </GroupBox>
    </Grid>
</Window>
